---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: merchant-producer
  namespace: ${NS}
spec:
  serviceName: merchant-producer
  podManagementPolicy: Parallel
  replicas: 1
  selector:
    matchLabels:
      app: merchant-producer
  template:
    metadata:
      labels:
        app: merchant-producer
    spec:
      containers:
      - name: merchant-producer
        image: confluentinc/cp-kafka:latest
        command:
        - /bin/sh
        - -c
        - |
          kafka-producer-perf-test \
            --topic demo.orders.avro.v1 \
            --record-size 512 \
            --throughput 5 \
            --producer.config /mnt/producer-kafka.properties \
            --num-records 100000
        volumeMounts:
        - name: producer-kafka-properties
          mountPath: /mnt
      volumes:
        - name: producer-kafka-properties
          secret:
            secretName: merchant-producer-config
---
apiVersion: v1
kind: Service
metadata:
  name: merchant-producer
  namespace: ${NS}
spec:
  clusterIP: None
