---
# Source topic
apiVersion: platform.confluent.io/v1beta1
kind: KafkaTopic
metadata:
  name: demo-orders-source
  namespace: ${NS}
spec:
  name: demo.orders.avro.v1
  replicas: 3
  partitionCount: 3
  kafkaRest:
    endpoint: ${SRC_KAFKA_REST}
    kafkaClusterID: ${SRC_CLUSTER}
    authentication:
      type: basic
      basic:
        secretRef: eu-smt-source-rest
---
# Pre-SMT name on DEST — required when topic.rename.format=${topic}
# (Replicator admin path); RegexRouter SMT writes to ccloud-eu.* below.
apiVersion: platform.confluent.io/v1beta1
kind: KafkaTopic
metadata:
  name: demo-orders-dest-presmt
  namespace: ${NS}
spec:
  name: demo.orders.avro.v1
  replicas: 3
  partitionCount: 3
  kafkaRest:
    endpoint: ${DST_KAFKA_REST}
    kafkaClusterID: ${DST_CLUSTER}
    authentication:
      type: basic
      basic:
        secretRef: eu-smt-dest-rest
---
# Post-SMT destination topic
apiVersion: platform.confluent.io/v1beta1
kind: KafkaTopic
metadata:
  name: demo-orders-dest-ccloud-eu
  namespace: ${NS}
spec:
  name: ccloud-eu.demo.orders.avro.v1
  replicas: 3
  partitionCount: 3
  kafkaRest:
    endpoint: ${DST_KAFKA_REST}
    kafkaClusterID: ${DST_CLUSTER}
    authentication:
      type: basic
      basic:
        secretRef: eu-smt-dest-rest
