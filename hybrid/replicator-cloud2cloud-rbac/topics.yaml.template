---
# Source topics
apiVersion: platform.confluent.io/v1beta1
kind: KafkaTopic
metadata:
  name: src-orders
  namespace: destination
spec:
  name: demo.orders.avro.v1
  replicas: 3
  partitionCount: 3
  kafkaRest:
    endpoint: ${KAFKA_REST}
    kafkaClusterID: ${SRC_CLUSTER}
    authentication:
      type: basic
      basic:
        secretRef: eu-rbac-source-rest
---
apiVersion: platform.confluent.io/v1beta1
