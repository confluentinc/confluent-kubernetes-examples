  namespace: destination
spec:
  name: demo.orders.avro.v1
  replicas: 3
  partitionCount: 3
  kafkaRest:
    endpoint: ${KAFKA_REST}
    kafkaClusterID: ${DST_CLUSTER}
    authentication:
      type: basic
      basic:
        secretRef: eu-rbac-dest-rest
